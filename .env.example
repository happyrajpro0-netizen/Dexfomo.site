# Dexfomo Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env or secrets to Git.

# Application URL
NEXT_PUBLIC_SITE_URL=https://dexfomo.site
NEXT_PUBLIC_APP_ENV=development

# Optional Analytics & Telemetry (Leave blank or configure with your provider)
NEXT_PUBLIC_ANALYTICS_ID=

# Admin Authentication Secret (Generate a strong 32+ character random secret)
ADMIN_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Rate Limiting & Storage Configuration
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# Blockchain RPC Endpoints (Optional for live RPC feeds; falls back to public rate-limited endpoints)
ETHEREUM_RPC_URL=https://eth.llamarpc.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org

# Notification Webhooks (Optional for lead/waitlist alerts)
WAITLIST_NOTIFICATION_WEBHOOK_URL=
CONTACT_NOTIFICATION_WEBHOOK_URL=
